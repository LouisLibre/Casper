# Casper's own terminal defaults. This is the lowest layer of the
# configuration cascade, loaded before the user's Ghostty config, so anything
# here can be overridden from ~/.config/ghostty/config or, for the notch
# only, from ~/.config/casper/config.ghostty.
#
# Keys are Ghostty's: https://ghostty.org/docs/config/reference
theme = Dark Pastel
window-padding-x = 4
window-padding-y = 6
window-padding-balance = true
window-padding-color = extend
# The notch body is liquid glass and supplies the terminal's darkness, so the
# surface renders with no background of its own. Anything above 0 shows a
# faint frame where the glass margin meets the terminal. Cell backgrounds
# (selections, TUI panes) stay solid so they remain readable.
background-opacity = 0
background-opacity-cells = 1
# Ghostty binds ⌘9 to the last tab and ⌘0 to resetting the font size. The
# dock numbers the first ten tabs and shows those numbers while ⌘ is held,
# so here ⌘9 is the ninth tab and ⌘0 the tenth, bound both ways Ghostty
# binds ⌘1 to ⌘8.
keybind = super+digit_9=goto_tab:9
keybind = super+9=goto_tab:9
keybind = super+digit_0=goto_tab:10
keybind = super+0=goto_tab:10
# Ghostty binds ⌘[ and ⌘] to moving between splits, which the notch has
# none of. Here they step to the previous and next tab, wrapping at the ends.
keybind = super+[=previous_tab
keybind = super+]=next_tab
